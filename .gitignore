# 模型权重（5.4GB，8 个文件均 >100MB，GitHub 连 LFS 都拒收）
# 用户自行按 README 说明放置到 models/ 下
# 注意前面的 / 只锚定根目录，避免误伤 see-through 内部的 models 代码目录
/models/

# 运行时产物
__pycache__/
*.pyc
launcher.log
recent_projects.json
import_game_dir.json
seethrough_out/
# 运行时目录（v3.6.2 起：最近工程 / 导入目录 / 启动日志都收进这里）
# 注意用 /.runtime/ 锚定根目录，避免误伤模块内同名目录
/.runtime/

# 系统/编辑器
Thumbs.db
.DS_Store

comfy_launch.log
launcher.log
recent_projects.json
__pycache__
*.pyc
dist/MuppetStudio-Setup.exe
# 安装包带版本号后的名字（v3.4.4 起）：同样只走 Release 分发，不入库。
# 419MB 远超 GitHub 单文件限制，且历史上直连上传反复被掐。
dist/MuppetStudio-Setup-v*.exe

# 用户工程目录（测试/实际使用都会生成，不入库）
/projects/

# WebGAL 官方运行时（~70MB，E1b 本地下载物；装机时由资产管线/安装包提供，
# 不进 git。注意：templates/webgal/ 是我们的产品模板，**必须**入库，
# 所以这里精确锚定 webgal_runtime 目录，不能写成 templates/runtime）
templates/webgal_runtime/
# 缩略图离线渲染生成宿主页（build_host_html() 按需重建，不入库）
templates/webgal/preview/_thumb_host.html

# Live2D core（专有许可，绝不入库；用户本地拷贝进导出包）
templates/**/live2d.min.js
templates/**/live2dcubismcore.min.js

# 资产库（1.1GB 素材，本地物）
/asset_library/
dist/MuppetStudio-Update-v*.zip

# PyInstaller �м�����������룩
build_launcher_dist/
build_launcher_work/

# 语音引擎（GPT-SoVITS）—— 仅本机测试用，不进 git
# 引擎 9.3GB + 音色 4GB；模型授权 CC-BY-NC 且禁止二次配布。
# 代码与文档放在仓库外：D:\work\puppet\语音接入、D:\gsv_slim\work
/voicesrv/
/voices/
/docs/语音接入/
/语音接入/

# 参考音频 / 音色素材（和引擎一样不进 git）：
#   · 参考音频是角色声音的克隆样本，版权同 13 个角色音色（CC-BY-NC，
#     不可二次配布）
#   · 体积不小（14 段约 4MB，以后可能更多）
#   · 用户自己导入的东西不该跟着代码走
/voice/
/refs/
*.ckpt
*.pth
